# ALL OPTIONAL. Duel Live is fully playable with this file empty.
#
# Tier 0 (procedural canvas + Web Speech voice) needs no key and no network.
# Tier 1 (AI still frames) works anonymously with no key.
# Tiers 2 and 3 (AI video and voice) need credentials for at least one provider.

# ---------------------------------------------------------------- video ---
# Providers are tried in order and the first one that is configured, affordable
# and working wins. Configure as many or as few as you like.

# Higgsfield — the only provider here with a real 480p tier, so it is tried
# first. Keys: https://higgsfield.ai  (API dashboard → keys)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Google Veo — https://aistudio.google.com/apikey  (720p floor, no 480p tier)
GEMINI_API_KEY=

# Pollinations — https://enter.pollinations.ai/keys  (free tier; also powers
# stills and voice below). 6-second minimum, billed 0.08 pollen per second.
POLLINATIONS_API_KEY=

# Order and quality. Quality is 480 or 720; providers without a 480p tier
# quietly use their own floor.
DUEL_VIDEO_PROVIDERS=higgsfield,pollinations,google
DUEL_VIDEO_QUALITY=480
DUEL_VIDEO_SECONDS=6

# Per-provider model overrides. Only change these if you know the tier allows it.
DUEL_VIDEO_MODEL=amazon/nova-reel-v1
DUEL_GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
DUEL_HIGGSFIELD_PATH=/bytedance/seedance/v1/lite/text-to-video

# --------------------------------------------------- stills, voice, misc ---
DUEL_IMAGE_MODEL=black-forest-labs/flux.1-schnell
DUEL_VOICE_MODEL=NamanSoni78/aura-2-atlas-en
DUEL_REALTIME_MODEL=openai/gpt-realtime-2.1-mini
PORT=4174

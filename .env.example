# ALL OPTIONAL. Duel Live is fully playable with this file empty.
#
# Tier 0 (procedural canvas cinema + Web Speech voice) needs no key and no network.
# Tier 1 (AI still frames) works anonymously with no key.
# Tier 2 (AI video) + Tier 3 (realtime voice) need one FREE key:
#   https://enter.pollinations.ai/keys  -- free tier, no card, covers every model below.
POLLINATIONS_API_KEY=

# Free-tier model choices. Override only if you know the tier allows it.
DUEL_VIDEO_MODEL=amazon/nova-reel-v1
DUEL_IMAGE_MODEL=black-forest-labs/flux.1-schnell
DUEL_TEXT_MODEL=openai/gpt-5.4-nano
DUEL_VOICE_MODEL=NamanSoni78/aura-2-atlas-en
DUEL_REALTIME_MODEL=openai/gpt-realtime-2.1-mini

# Cinema budget. Video is slow; these keep the duel watchable.
DUEL_VIDEO_SECONDS=6
DUEL_VIDEO_WIDTH=768
DUEL_VIDEO_HEIGHT=432
PORT=4174
